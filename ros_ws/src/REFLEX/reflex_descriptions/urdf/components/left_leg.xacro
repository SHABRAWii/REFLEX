<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="reflex_left_leg" params="prefix parent">

    <!-- Left Hip link -->
    <link name="${prefix}Left_Hip">
      <inertial>
        <origin xyz="0.049151 -0.09472 -4.3652E-08" rpy="0 0 0"/>
        <mass value="1.5424"/>
        <inertia
          ixx="0.010215" ixy="0.0004342" ixz="-5.0861E-10"
          iyy="0.0011474" iyz="-1.6319E-10"
          izz="0.0093639"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Hip.STL"/>
        </geometry>
        <material name="reflex_grey">
          <color rgba="0.69804 0.69804 0.69804 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Hip.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Hip joint -->
    <joint name="${prefix}Left_Hip_joint" type="revolute">
      <origin xyz="0.2064 0.19 -0.07" rpy="0.7854 0 3.1416"/>
      <parent link="${parent}"/>
      <child link="${prefix}Left_Hip"/>
      <!-- ! NOTE: SolidWorks exported axis="0 0 0" (invalid). Fix axis based on your hinge. -->
      <axis xyz="-1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="11.0" velocity="43.98"/>
    </joint>

    <!-- Left Knee link -->
    <link name="${prefix}Left_Knee">
      <inertial>
        <origin xyz="0.015086 -0.090977 0" rpy="0 0 0"/>
        <mass value="0.77384"/>
        <inertia
          ixx="0.0056428" ixy="1.1442E-05" ixz="-8.411E-19"
          iyy="0.00055297" iyz="-3.8218E-18"
          izz="0.0052588"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Knee.STL"/>
        </geometry>
        <material name="reflex_grey">
          <color rgba="0.69804 0.69804 0.69804 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Knee.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Knee joint -->
    <joint name="${prefix}Left_Knee_joint" type="revolute">
      <origin xyz="0.0775 -0.2 0" rpy="1.8984 0 3.1416"/>
      <parent link="${prefix}Left_Hip"/>
      <child link="${prefix}Left_Knee"/>
      <!-- ! NOTE: SolidWorks exported axis="0 0 0" (invalid). Fix axis based on your hinge. -->
      <axis xyz="-1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="11.0" velocity="43.98"/>
    </joint>

    <!-- Left Wheel link -->
    <link name="${prefix}Left_Wheel">
      <inertial>
        <origin xyz="-2.7523E-06 1.3292E-06 0.029027" rpy="0 0 0"/>
        <mass value="0.5169"/>
        <inertia
          ixx="0.0012561" ixy="6.7857E-09" ixz="2.8567E-08"
          iyy="0.0012561" iyz="-7.6346E-09"
          izz="0.0023843"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Wheel.STL"/>
        </geometry>
        <material name="reflex_blue">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Left_Wheel.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Wheel joint -->
    <joint name="${prefix}Left_Wheel_Joint" type="fixed">
      <origin xyz="0.04 -0.2 0" rpy="-1.5708 -0.91317 -1.5708"/>
      <parent link="${prefix}Left_Knee"/>
      <child link="${prefix}Left_Wheel"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>

</robot>
