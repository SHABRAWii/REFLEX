<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="reflex_right_leg" params="prefix parent">

    <!-- Right Hip link -->
    <link name="${prefix}Right_Hip">
      <inertial>
        <origin xyz="-0.048349 -0.040744 0.08551" rpy="0 0 0"/>
        <mass value="1.5424"/>
        <inertia
          ixx="0.010215" ixy="0.00018677" ixz="-0.00039198"
          iyy="0.0078436" iyz="0.0031906"
          izz="0.0026677"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Hip.STL"/>
        </geometry>
        <material name="reflex_grey">
          <color rgba="0.69804 0.69804 0.69804 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Hip.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Hip joint -->
    <joint name="${prefix}Right_Hip_Joint" type="revolute">
      <origin xyz="-0.1089 0.19 -0.07" rpy="-2.8009 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}Right_Hip"/>
      <axis xyz="1 0 0"/>
      <!-- NOTE: SolidWorks exported 0/0 limits. Replace with real joint limits. -->
      <limit lower="0" upper="0" effort="0" velocity="0"/>
    </joint>

    <!-- Right Knee link -->
    <link name="${prefix}Right_Knee">
      <inertial>
        <origin xyz="0.015086 -0.090977 -3.8858E-16" rpy="0 0 0"/>
        <mass value="0.77384"/>
        <inertia
          ixx="0.0056428" ixy="1.1442E-05" ixz="-1.8135E-18"
          iyy="0.00055297" iyz="-1.297E-17"
          izz="0.0052588"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Knee.STL"/>
        </geometry>
        <material name="reflex_grey">
          <color rgba="0.69804 0.69804 0.69804 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Knee.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Knee joint -->
    <joint name="${prefix}Right_Knee_joint" type="revolute">
      <origin xyz="-0.02 -0.08603 0.18055" rpy="-0.77222 0 3.1416"/>
      <parent link="${prefix}Right_Hip"/>
      <child link="${prefix}Right_Knee"/>
      <!-- ! NOTE: SolidWorks exported axis="0 0 0" (invalid). Fix axis based on your hinge. -->
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0" effort="0" velocity="0"/>
    </joint>

    <!-- Right Wheel link -->
    <link name="${prefix}Right_Wheel">
      <inertial>
        <origin xyz="-0.00020036 1.3304E-06 0.029027" rpy="0 0 0"/>
        <mass value="0.5169"/>
        <inertia
          ixx="0.0012561" ixy="6.8224E-09" ixz="2.8546E-08"
          iyy="0.0012561" iyz="-7.6289E-09"
          izz="0.0023843"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Wheel.STL"/>
        </geometry>
        <material name="reflex_blue">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(find reflex_descriptions)/models/Right_Wheel.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Wheel joint -->
    <joint name="${prefix}Right_Wheel_Joint" type="continuous">
      <origin xyz="0.04 -0.2 0" rpy="1.5708 -0.91317 1.5708"/>
      <parent link="${prefix}Right_Knee"/>
      <child link="${prefix}Right_Wheel"/>
      <axis xyz="0 0 -1"/>
    </joint>

  </xacro:macro>

</robot>
